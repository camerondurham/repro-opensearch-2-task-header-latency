+package org.opensearch.action.search;
+
+import org.opensearch.Version;
+import org.opensearch.action.support.ActionFilters;
+import org.opensearch.cluster.ClusterName;
+import org.opensearch.cluster.ClusterState;
+import org.opensearch.cluster.service.ClusterService;
+import org.opensearch.common.util.concurrent.AtomicArray;
+import org.opensearch.common.util.concurrent.ThreadContext;
+import org.opensearch.core.action.ActionListener;
+import org.opensearch.search.SearchPhaseResult;
+import org.opensearch.tasks.TaskManager;
+import org.opensearch.tasks.TaskResourceTrackingService;
+import org.opensearch.test.OpenSearchTestCase;
+import org.opensearch.threadpool.TestThreadPool;
+import org.opensearch.threadpool.ThreadPool;
+import org.opensearch.transport.TransportService;
+
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicReference;
+import java.util.function.Supplier;
+
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+public class TransportSearchScrollActionTests extends OpenSearchTestCase {
+    private static final String RESOURCE = TaskResourceTrackingService.TASK_RESOURCE_USAGE;
+    private static final String OTHER = "X-Unrelated";
+    private static final String REQUEST = "X-Request";
+    private static final String TRANSIENT = "transient";
+
+    private ThreadPool threadPool;
+    private ThreadContext context;
+    private TransportSearchScrollAction action;
+
+    @Override
+    public void setUp() throws Exception {
+        super.setUp();
+        threadPool = new TestThreadPool("test");
+        context = threadPool.getThreadContext();
+        TransportService transportService = mock(TransportService.class);
+        when(transportService.getThreadPool()).thenReturn(threadPool);
+        when(transportService.getTaskManager()).thenReturn(mock(TaskManager.class));
+        ClusterService clusterService = mock(ClusterService.class);
+        when(clusterService.state()).thenReturn(ClusterState.builder(new ClusterName("test")).build());
+        action = new TransportSearchScrollAction(
+            transportService,
+            clusterService,
+            new ActionFilters(Collections.emptySet()),
+            mock(SearchTransportService.class),
+            new SearchPhaseController(writableRegistry(), request -> null)
+        );
+        context.putHeader(REQUEST, "request-value");
+        context.putTransient(TRANSIENT, "transient-value");
+        context.addResponseHeader(RESOURCE, "resource-value");
+        context.addResponseHeader(OTHER, "other-a");
+        context.addResponseHeader(OTHER, "other-b");
+    }
+
+    @Override
+    public void tearDown() throws Exception {
+        assertTrue(ThreadPool.terminate(threadPool, 10, TimeUnit.SECONDS));
+        super.tearDown();
+    }
+
+    public void testMalformedScrollIdCleansBeforeFailure() {
+        assertTrue(execute("malformed") instanceof IllegalArgumentException);
+    }
+
+    public void testQueryThenFetchEmptyScrollCleansBeforeFailure() {
+        AtomicArray<SearchPhaseResult> results = new AtomicArray<>(0);
+        assertEmptyScrollFailure(TransportSearchHelper.buildScrollId(results, Version.CURRENT), ParsedScrollId.QUERY_THEN_FETCH_TYPE);
+    }
+
+    public void testQueryAndFetchEmptyScrollCleansBeforeFailure() {
+        AtomicArray<SearchPhaseResult> results = new AtomicArray<>(1);
+        String scrollId = TransportSearchHelper.buildScrollId(results, Version.CURRENT);
+        assertEmptyScrollFailure(scrollId, ParsedScrollId.QUERY_AND_FETCH_TYPE);
+    }
+
+    public void testCleanupHelperPreservesSuccessfulResponseAndCapturedContext() {
+        SearchResponse response = mock(SearchResponse.class);
+        AtomicReference<SearchResponse> observed = new AtomicReference<>();
+        AtomicReference<Supplier<ThreadContext.StoredContext>> captured = new AtomicReference<>();
+        ActionListener<SearchResponse> delegate = ActionListener.wrap(value -> {
+            observed.set(value);
+            captured.set(context.newRestorableContext(true));
+        }, e -> fail(e.getMessage()));
+        TransportSearchScrollAction.clearScrollResourceUsage(context, delegate).onResponse(response);
+        assertSame(response, observed.get());
+        try (ThreadContext.StoredContext changed = context.stashContext()) {
+            context.addResponseHeader(OTHER, "changed");
+            try (ThreadContext.StoredContext restored = captured.get().get()) {
+                assertFalse(context.getResponseHeaders().containsKey(RESOURCE));
+                assertEquals(Arrays.asList("changed", "other-a", "other-b"), context.getResponseHeaders().get(OTHER));
+                assertEquals("request-value", context.getHeader(REQUEST));
+                assertEquals("transient-value", context.getTransient(TRANSIENT));
+            }
+        }
+    }
+
+    private void assertEmptyScrollFailure(String scrollId, String expectedType) {
+        ParsedScrollId parsed = TransportSearchHelper.parseScrollId(scrollId);
+        assertEquals(expectedType, parsed.getType());
+        assertEquals(0, parsed.getContext().length);
+        Exception failure = execute(scrollId);
+        assertTrue(failure instanceof SearchPhaseExecutionException);
+        assertEquals("no nodes to search on", failure.getMessage());
+    }
+
+    private Exception execute(String scrollId) {
+        AtomicInteger callbacks = new AtomicInteger();
+        AtomicReference<Exception> failure = new AtomicReference<>();
+        action.doExecute(task(), new SearchScrollRequest().scrollId(scrollId), ActionListener.wrap(response -> fail(), e -> {
+            callbacks.incrementAndGet();
+            assertBoundary();
+            failure.set(e);
+        }));
+        assertEquals(1, callbacks.get());
+        return failure.get();
+    }
+
+    private SearchTask task() {
+        return new SearchTask(1, "transport", SearchAction.NAME, () -> "test", null, Collections.emptyMap());
+    }
+
+    private void assertBoundary() {
+        assertFalse(context.getResponseHeaders().containsKey(RESOURCE));
+        assertEquals(Arrays.asList("other-a", "other-b"), context.getResponseHeaders().get(OTHER));
+        assertEquals("request-value", context.getHeader(REQUEST));
+        assertEquals("transient-value", context.getTransient(TRANSIENT));
+    }
+}
